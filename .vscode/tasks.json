{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "carlosstor: iniciar vista previa",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": ".*",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "carlosstor disponible",
          "endsPattern": "Guarda un archivo"
        }
      }
    }
  ]
}
